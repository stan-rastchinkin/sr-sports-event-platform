{
  "name": "sports-event-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Sports Event Platform backend",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env.dev src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env.dev dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "tsc -p tsconfig.test.json && node --experimental-vm-modules --env-file=.env.test ./node_modules/jest/bin/jest.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migration:generate": "node --env-file=.env.dev ./node_modules/typeorm/cli-ts-node-esm.js migration:generate -d src/persistence/data-source.ts",
    "migration:create": "node --env-file=.env.dev ./node_modules/typeorm/cli-ts-node-esm.js migration:create",
    "migration:run": "node --env-file=.env.dev ./node_modules/typeorm/cli-ts-node-esm.js migration:run -d src/persistence/data-source.ts",
    "migration:revert": "node --env-file=.env.dev ./node_modules/typeorm/cli-ts-node-esm.js migration:revert -d src/persistence/data-source.ts",
    "migration:show": "node --env-file=.env.dev ./node_modules/typeorm/cli-ts-node-esm.js migration:show -d src/persistence/data-source.ts"
  },
  "dependencies": {
    "@fastify/swagger": "9",
    "@fastify/swagger-ui": "5",
    "@fastify/type-provider-zod": "^1.0.3",
    "fastify": "5",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typedi": "^0.10.0",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26",
    "@types/pg": "^8",
    "eslint": "10",
    "eslint-plugin-perfectionist": "^5.13.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
